# Copia este archivo como .env.local y rellena los valores. .env.local no se sube a GitHub.

# Supabase (opcional): sin estas dos variables la app funciona en modo demo local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el script de carga de datos (npm run db:seed). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: para graduar síntomas y responder dudas con IA.
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=
